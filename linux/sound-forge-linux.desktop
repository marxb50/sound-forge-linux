[Desktop Entry]
Type=Application
Name=Sound Forge Linux
GenericName=Audio Waveform Editor
Comment=Clean-room Rust audio editor inspired by Sound Forge Pro 10.0
Exec=sound-forge-linux %f
Icon=sound-forge-linux
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;
